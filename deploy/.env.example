# Copy to .env and edit. Docker Compose reads this file for the stack, and passes it to the server as well.

# Which proxy fronts the server: compose.caddy.yaml (built in) or compose.traefik.yaml (your existing Traefik).
COMPOSE_FILE=compose.yaml:compose.caddy.yaml

# Public host name of this server; clients use https://<TOE3_DOMAIN>.
TOE3_DOMAIN=cloud.example.com

# Database password; generate one, e.g. with `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# Image tag to run, e.g. v1.0.0. "latest" follows the newest release.
TOE3_VERSION=latest

# Proxies whose X-Forwarded-For is believed. The app's port is not published, so only containers on its Docker
# networks (Caddy or Traefik) can reach it; Docker's default address pools are therefore safe to trust. Narrow this if
# your Docker daemon uses other address pools.
TOE3_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# closed: accounts are created with `docker compose exec app toe3-cloud user add <name>`; open: players may register.
TOE3_REGISTRATION=closed

# Optional server settings (defaults shown).
#TOE3_MAX_SNAPSHOT_BYTES=16777216
#TOE3_RETENTION=20
#TOE3_SESSION_TTL=2160h

# Optional S3-compatible blob storage instead of the blobs volume.
#TOE3_BLOB_BACKEND=s3
#TOE3_S3_ENDPOINT=https://s3.example.com
#TOE3_S3_REGION=us-east-1
#TOE3_S3_BUCKET=toe3-saves
#TOE3_S3_PREFIX=
#TOE3_S3_PATH_STYLE=false
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Caddy only: host ports to publish.
#TOE3_HTTP_PORT=80
#TOE3_HTTPS_PORT=443

# Traefik only: your Traefik's network, entrypoint and certificate resolver.
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
