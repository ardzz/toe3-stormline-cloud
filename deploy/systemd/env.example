# /etc/toe3-cloud/env — settings for toe3-cloud.service (mode 0600: it holds the database password). Quote values
# containing shell characters such as & so the file can also be sourced by a shell.

TOE3_DATABASE_URL="postgres://toe3:CHANGE-ME@127.0.0.1:5432/toe3?sslmode=disable"
TOE3_LISTEN=127.0.0.1:8080
# The local reverse proxy (Caddy, Traefik, nginx) connects from loopback.
TOE3_TRUSTED_PROXIES=127.0.0.1,::1
TOE3_REGISTRATION=closed

# Optional (defaults shown).
#TOE3_MAX_SNAPSHOT_BYTES=16777216
#TOE3_RETENTION=20
#TOE3_SESSION_TTL=2160h
#TOE3_BLOB_DIR=/var/lib/toe3-cloud/blobs

# Optional S3-compatible blob storage.
#TOE3_BLOB_BACKEND=s3
#TOE3_S3_ENDPOINT=https://s3.example.com
#TOE3_S3_REGION=us-east-1
#TOE3_S3_BUCKET=toe3-saves
#TOE3_S3_PREFIX=
#TOE3_S3_PATH_STYLE=false
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
